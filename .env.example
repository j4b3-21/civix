# ---------------------------------------------------------------------------
# CIVIX environment template. Copy to .env and replace every CHANGE_ME value.
# Generate secrets with:  openssl rand -base64 48
# Never commit .env.
# ---------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
CIVIX_ENV=local                              # local | staging | production
CIVIX_PUBLIC_URL=http://localhost:3000       # browser-facing origin (used for cookies/CORS/links)
CIVIX_ENABLE_TEST_SERVICES=true              # shows the CIVIX Test Portal service; MUST be false in production
TZ=Asia/Kolkata

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=civix
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# API role (owns schema "civix", runs Flyway)
CIVIX_DB_URL=jdbc:postgresql://postgres:5432/civix
CIVIX_DB_USER=civix_api
CIVIX_DB_PASSWORD=CHANGE_ME
# Agent role (owns schema "agent" only: LangGraph checkpoints, task runs, event outbox).
# docker-compose builds AGENT_DATABASE_URL from AGENT_DB_PASSWORD; set it explicitly only outside compose.
AGENT_DB_PASSWORD=CHANGE_ME

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Object storage (MinIO locally, any S3 in production) ---------------------
S3_ENDPOINT=http://storage:9000
S3_REGION=ap-south-1
S3_BUCKET=civix-private
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_SSE=AES256                                # server-side encryption header sent on every PUT
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# 32-byte base64 key for MinIO's built-in KMS (enables SSE-S3). Format: <key-name>:<base64-key>
MINIO_KMS_SECRET_KEY=civix-key:CHANGE_ME_BASE64_32_BYTES

# --- API (Spring Boot) ---------------------------------------------------------
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES       # HS256 signing key for access tokens
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECURE=false                          # true behind HTTPS
AUDIT_IP_PEPPER=CHANGE_ME
CIVIX_OPENAPI_ENABLED=true
CIVIX_ADMIN_EMAILS=                          # comma-separated emails promoted to ADMIN on registration

# --- Service-to-service tokens (distinct values!) -------------------------------
API_INTERNAL_TOKEN=CHANGE_ME                 # agent -> api   (/internal/v1/** on api)
AGENT_INTERNAL_TOKEN=CHANGE_ME               # api -> agent   (/internal/v1/** on agent)
BROWSER_WORKER_TOKEN=CHANGE_ME               # agent -> browser-worker
APPROVAL_SIGNING_SECRET=CHANGE_ME            # HMAC key for approval tokens (api signs; agent + worker verify)

# --- Service URLs (internal docker network) -------------------------------------
API_INTERNAL_URL=http://api:8080
AGENT_INTERNAL_URL=http://agent:8000
BROWSER_WORKER_URL=http://browser-worker:8001

# --- Agent ----------------------------------------------------------------------
SERVICE_REGISTRY_PATH=/app/service-registry
NODE_TIMEOUT_SECONDS=120
BROWSER_STEP_TIMEOUT_SECONDS=60
MAX_RECOVERY_ATTEMPTS_PER_STEP=3
MAX_RECOVERY_ATTEMPTS_PER_TASK=8
APPROVAL_TTL_SECONDS=900
MAX_CONCURRENT_TASKS=4
OFFICIAL_SOURCE_FETCH_ENABLED=false          # live re-fetch of official source pages during discovery
BRAVE_SEARCH_API_KEY=                       # optional; official-domain search for live discovery
DATA_GOV_API_KEY=                           # optional; key from data.gov.in for resource API calls
DATA_GOV_BASE_URL=https://api.data.gov.in

# --- LLM ------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible               # openai_compatible | anthropic | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1   # local model server (Ollama, vLLM, LM Studio)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=qwen2.5:0.5b
LLM_COST_PER_1K_INPUT_TOKENS_USD=0.003
LLM_COST_PER_1K_OUTPUT_TOKENS_USD=0.015
LLM_MAX_COST_PER_TASK_USD=1.00
LLM_MAX_DAILY_COST_PER_USER_USD=5.00

# --- Browser worker ---------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_MAX_SESSIONS=4
BROWSER_SESSION_IDLE_TIMEOUT_SECONDS=900
# Hosts allowed to resolve to private IPs (only the local test portal). Empty in production.
BROWSER_PRIVATE_HOST_ALLOWLIST=test-portal

# --- Test portal (authorized local test environment, NOT a government site) ------
TEST_PORTAL_URL=http://test-portal:8090

# --- Web (Next.js) ------------------------------------------------------------------
API_PROXY_TARGET=http://api:8080             # Next.js rewrites /api/v1/* here (server side)
NEXT_PUBLIC_APP_NAME=CIVIX
