      },
      "ApprovalKind": {
        "type": "string",
        "enum": [
          "PREPARATION",
          "DOCUMENT_UPLOAD",
          "FINAL_SUBMISSION"
        ],
        "title": "ApprovalKind"
      },
      "ApprovalResume": {
        "properties": {
          "approvalId": {
            "type": "string",
            "title": "Approvalid"
          },
          "approvalKind": {
            "$ref": "#/components/schemas/ApprovalKind"
          },
          "decision": {
            "$ref": "#/components/schemas/ApprovalDecision"
          },
          "token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
