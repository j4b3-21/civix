      "ResumeRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "APPROVAL",
              "CITIZEN_INPUT",
              "RETRY"
            ],
            "title": "Kind"
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalResume"
              },
              {
                "type": "null"
              }
            ]
          },
          "citizenInput": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CitizenInputResume"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "ResumeRequest"
      },
      "ServiceCategory": {
        "type": "string",
        "enum": [
          "EDUCATION",
          "SCHOLARSHIPS",
          "CERTIFICATES",
          "IDENTITY",
          "WELFARE",
          "AGRICULTURE",
          "BUSINESS",
          "LICENSES",
          "EMPLOYMENT",
          "UTILITIES",
          "OTHER"
        ],
        "title": "ServiceCategory"
      },
      "StartTaskRequest": {
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "Taskid"
          },
          "applicationId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "Applicationid"
          },
          "userId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "Userid"
          },
          "serviceCode": {
            "type": "string",
            "maxLength": 80,
            "title": "Servicecode"
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "citizenContext": {
            "$ref": "#/components/schemas/CitizenContext"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/TaskDocument"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Documents"
          },
          "dataVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Dataversion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taskId",
          "applicationId",
          "userId",
          "serviceCode",
          "citizenContext",
          "dataVersion"
        ],
        "title": "StartTaskRequest"
      },
      "TaskDocument": {
        "properties": {
          "documentId": {
            "type": "string",
            "title": "Documentid"
          },
          "category": {
            "$ref": "#/components/schemas/DocumentCategory"
          },
          "storageKey": {
            "type": "string",
            "title": "Storagekey"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "fileName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documentId",
          "category",
          "storageKey",
          "mimeType"
        ],
        "title": "TaskDocument"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}