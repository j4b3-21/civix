        "title": "JurisdictionLevel"
      },
      "OtherDocument": {
        "properties": {
          "documentId": {
            "type": "string",
            "title": "Documentid"
          },
          "category": {
            "$ref": "#/components/schemas/DocumentCategory"
          },
          "fields": {
            "items": {
              "additionalProperties": true,
