              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approvalId",
          "approvalKind",
          "decision"
        ],
        "title": "ApprovalResume"
      },
      "CancelRequest": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CancelRequest"
      },
      "CitizenContext": {
        "properties": {
          "userId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Userid"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ContextField"
            },
            "type": "object",
            "title": "Fields"
          },
          "consents": {
            "items": {
              "$ref": "#/components/schemas/ConsentPurpose"
            },
            "type": "array",
            "title": "Consents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CitizenContext"
      },
      "CitizenInputResume": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "value": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "value"
        ],
        "title": "CitizenInputResume"
      },
      "ConsentPurpose": {
        "type": "string",
        "enum": [
          "PROFILE_PROCESSING",
          "DOCUMENT_PROCESSING",
          "ELIGIBILITY_EVALUATION",
          "AGENT_EXECUTION",
          "PORTAL_DOCUMENT_UPLOAD"
        ],
        "title": "ConsentPurpose"
      },
      "ContextField": {
        "properties": {
          "value": {
            "title": "Value"
          },
          "status": {
            "$ref": "#/components/schemas/ProfileFieldStatus"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FieldSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceDocumentId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcedocumentid"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ContextField"
      },
      "DiscoveryFilters": {
        "properties": {
          "state": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^IN-[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServiceCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "jurisdiction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JurisdictionLevel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DiscoveryFilters"
      },
      "DiscoveryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Query"
          },
          "filters": {
            "$ref": "#/components/schemas/DiscoveryFilters"
          },
          "citizenContext": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CitizenContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "includeTest": {
            "type": "boolean",
            "title": "Includetest",
            "default": false
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "DiscoveryRequest"
      },
      "DocumentCategory": {
        "type": "string",
        "enum": [
          "IDENTITY_PROOF",
          "ADDRESS_PROOF",
          "INCOME_CERTIFICATE",
          "CASTE_CERTIFICATE",
          "ACADEMIC_RECORD",
          "BANK_DOCUMENT",
          "RESIDENCE_CERTIFICATE",
          "DISABILITY_CERTIFICATE",
          "PHOTOGRAPH",
          "OTHER"
        ],
        "title": "DocumentCategory"
      },
      "EligibilityRequest": {
        "properties": {
          "serviceCode": {
            "type": "string",
            "title": "Servicecode"
          },
          "citizenContext": {
            "$ref": "#/components/schemas/CitizenContext"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "serviceCode",
          "citizenContext"
        ],
        "title": "EligibilityRequest"
      },
      "ExtractRequest": {
        "properties": {
          "documentId": {
            "type": "string",
            "title": "Documentid"
          },
          "storageKey": {
            "type": "string",
            "pattern": "^users/[0-9a-fA-F-]{36}/documents/[0-9a-fA-F-]{36}$",
            "title": "Storagekey"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "application/pdf",
              "image/png",
              "image/jpeg"
            ],
            "title": "Mimetype"
          },
          "declaredCategory": {
            "$ref": "#/components/schemas/DocumentCategory"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "citizenContext": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CitizenContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "otherDocuments": {
            "items": {
              "$ref": "#/components/schemas/OtherDocument"
            },
            "type": "array",
            "title": "Otherdocuments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documentId",
          "storageKey",
          "mimeType",
          "declaredCategory"
        ],
        "title": "ExtractRequest"
      },
      "FieldSource": {
        "type": "string",
        "enum": [
          "USER_INPUT",
          "DOCUMENT_EXTRACTION",
          "VERIFIED_SOURCE"
        ],
        "title": "FieldSource"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intent": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "APPLY",
              "DISCOVER"
            ],
            "title": "Type",
            "default": "APPLY"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Intent"
      },
      "JurisdictionLevel": {
        "type": "string",
        "enum": [
